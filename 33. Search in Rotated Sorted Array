class Solution {
public:
    int search(vector<int>& arr, int target) {
        int n = arr.size();
        int low = 0, hig = n-1;
        while(low <= hig) {
            int mid = low + (hig-low)/2;
            if(arr[mid]==target) return mid;
            if(arr[low] <= arr[mid]) {
                if(arr[low] <= target && target <= arr[mid]) hig = mid-1;
                else low = mid+1;
            }
            else{
                if(arr[mid] <= target && target <= arr[hig]) low = mid+1;
                else hig = mid-1;
            }
        }
        return -1;
    }
};
