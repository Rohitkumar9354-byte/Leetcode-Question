class Solution {
public:
    string longestPalindrome(string s) {
        string ans= "";
        for(int i = 0; i < s.size(); i++) {
            for(int j = i; j < s.size(); j++) {
                int l = i, r = j;
                bool ok = true;
            
            while(l < r) {
                if(s[l] != s[r]) {
                ok = false;
                break;
            }
            l++;
            r--;
        }
        if(ok && j-i+1 > ans.size()) { 
        ans = s.substr(i, j-i+1);
        }
      }
    }
    return ans;
 }
};
