 class Solution {
public:
    vector<int> findIntersectionValues(vector<int>& a, vector<int>& b) {
        int m = a.size(), n = b.size();
        int ans1 = 0;
        int ans2 = 0;
        for(int i = 0; i < m; i++) {
            for(int j = 0; j < n; j++) {
                if(a[i] == b[j]) {
                    ans1++;
                    break;
                }
            }
        }
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                if(b[i] == a[j]) {
                    ans2++;
                    break;
                }
            }
        }
        return {ans1, ans2};
    }
};
